# Copy to .env for reference, then export values in your shell before starting
# the app. Do not commit real stream URLs or credentials.
SAFE_DRIVE_CAMERA_CONFIG=config/camera.json
SAFE_DRIVE_DATABASE=local_data/safe_drive.sqlite3
# Optional: SAFE_DRIVE_CAMERA_MODE=rtsp
# Optional: SAFE_DRIVE_CAMERA_ID=gate-east
# Environment URL overrides config/camera.json. Keep credentials private.
SAFE_DRIVE_CAMERA_URL=
# Used only when SAFE_DRIVE_CAMERA_MODE=webcam
SAFE_DRIVE_WEBCAM_INDEX=0
