# Copy to .env for reference, then export values in your shell before starting
# the app. Do not commit real stream URLs or credentials.
SAFE_DRIVE_CAMERA_CONFIG=config/camera.json
SAFE_DRIVE_DATABASE=local_data/safe_drive.sqlite3
# Optional: SAFE_DRIVE_CAMERA_MODE=rtsp
# Optional: SAFE_DRIVE_CAMERA_ID=gate-east
# Environment URL overrides config/camera.json. Keep credentials private.
SAFE_DRIVE_CAMERA_URL=
# Used only when SAFE_DRIVE_CAMERA_MODE=webcam
SAFE_DRIVE_WEBCAM_INDEX=0
# Controlled public demo (configure through the host's environment/secret UI)
# SAFE_DRIVE_ENV=production
# SAFE_DRIVE_SECRET=<generate a random 32+ character value>
# SAFE_DRIVE_ALLOWED_HOSTS=your-service.onrender.com
# SAFE_DRIVE_USERS_JSON=<JSON mapping usernames to password_hash and role>
# SAFE_DRIVE_TRUST_PROXY=1  # only behind one trusted TLS-terminating proxy
# SAFE_DRIVE_ALLOW_UPLOADS=0
# SAFE_DRIVE_ENABLE_CAMERAS=0
# SAFE_DRIVE_DATA=/var/data/safe-drive
# SAFE_DRIVE_DATABASE=/var/data/safe-drive/safe_drive.sqlite3
# SAFE_DRIVE_MODEL=/private/operator-supplied/detector.pt
# SAFE_DRIVE_SAMPLE_VIDEO=/var/data/public-sample.mp4
# SAFE_DRIVE_SAMPLE_LICENSE=<actual licence/permission attribution>
# Private local operator instance only: IP literals, not DNS or client URLs
# SAFE_DRIVE_CAMERA_ALLOWED_IPS=10.0.0.2

# Optional helmet detector: exact three-class workflow in docs/HELMET_MODEL.md
# SAFE_DRIVE_HELMET_MODEL=/private/models/helmet-v1.pt
# See config/helmet.example.env for abstention and temporal thresholds.
# SAFE_DRIVE_CAMERA_CONNECT_RETRIES=1
# SAFE_DRIVE_RISK_HORIZON_S=5
# SAFE_DRIVE_RISK_TTC_S=1.5
# SAFE_DRIVE_RISK_DISTANCE_M=2
